# =============================================================================
# tpm-pregledi — produkcijska konfiguracija (TEMPLATE, bez pravih vrednosti).
# =============================================================================
# Pravi `.env` živi u /opt/apps/tpm-pregledi/ VAN gita; ovaj fajl dokumentuje šta
# aplikacija očekuje.
#
#   cd /opt/apps/tpm-pregledi
#   cp .env.example .env && nano .env     # popuni <<...>>
#   chmod 600 .env
#
# PRAVILO KVOTIRANJA: sve vrednosti u JEDNOSTRUKIM navodnicima. Lozinke sa
# znakovima ! ( ) ; & | < > * ? # i razmakom bez navodnika lome i compose i
# deploy.sh. Unutar jednostrukih navodnika sve je doslovno.
#
# Razmena vrednosti: Passbolt. `deploy/scripts/deploy.sh` odbija start dok je
# bilo koja vrednost <<...>>, dok je JWT_SECRET kratak ili dok je lozinka dev.
# =============================================================================

# ─── Domen ──────────────────────────────────────────────────────────────────
# Pun FQDN (bez https://). Ide u Traefik Host(), CORS i AllowedHosts.
APP_DOMAIN='tpm-pregledi.elixirgroup.rs'

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB='tpm_pregledi'
POSTGRES_USER='tpm_pregledi'
POSTGRES_PASSWORD='<<random 24+ chars: openssl rand -base64 24>>'

# ─── JWT ────────────────────────────────────────────────────────────────────
# HS256 ključ: 32 bajta minimum = 44 base64 karaktera; preporuka 64 bajta:
#   openssl rand -base64 64 | tr -d '\n'
# Promena = svi korisnici se izloguju.
JWT_SECRET='<<base64, najmanje 44 karaktera>>'

# ─── Inicijalni admin ───────────────────────────────────────────────────────
# Seed ga kreira SAMO ako nijedan admin ne postoji. Lozinku promeniti iz UI
# (korisnički meni → Promena lozinke) posle prve prijave. Min 12 znakova.
ADMIN_INITIAL_USERNAME='admin'
ADMIN_INITIAL_EMAIL='admin@tpm-pregledi.elixirgroup.rs'
ADMIN_INITIAL_PASSWORD='<<jaka lozinka, min 12 znakova>>'

# ─── Trenutno deploy-ovana verzija ──────────────────────────────────────────
# NE popunjavati ručno. deploy.sh upisuje tag iz učitanog tar-a posle svakog
# uspešnog deploy-a, da bi `docker compose ps|logs|exec` radili bez
# eksplicitnog IMAGE_TAG-a. Rollback: IMAGE_TAG=<stari> docker compose up -d
IMAGE_TAG=
